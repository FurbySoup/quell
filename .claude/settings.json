{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Python314\\python.exe \".claude/hooks/session_git_status.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Python314\\python.exe \".claude/hooks/live_proving_reminder.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Python314\\python.exe \".claude/hooks/planning_live_prove.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Python314\\python.exe \".claude/hooks/systematic_debugging.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "C:\\Python314\\python.exe \".claude/hooks/push_reminder.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Python314\\python.exe \".claude/hooks/branch_phase_check.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Python314\\python.exe \".claude/hooks/pre_commit_gate.py\"",
            "timeout": 180
          },
          {
            "type": "command",
            "command": "C:\\Python314\\python.exe \".claude/hooks/commit_discipline.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Python314\\python.exe \".claude/hooks/gitignore_check.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
